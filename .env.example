DATABASE_URL=mysql+pymysql://jira:jira123@localhost:3306/jira_clone
SECRET_KEY=change-me-in-production-use-long-random-string
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Google Calendar integration — see Task 5 for how to obtain these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=
ENABLE_GOOGLE_WATCH=false
TOKEN_ENCRYPTION_KEY=
GOOGLE_SYNC_POLL_INTERVAL_MINUTES=5
# Controls whether this process starts the background Google-sync scheduler.
# In a multi-worker deployment (e.g. gunicorn -w N) this MUST be true on exactly
# ONE worker/process — otherwise every worker polls every account concurrently,
# causing duplicate pull-sync upserts and watch-channel renewal races. Set it to
# false on all but one process (or run the scheduler as a separate single instance).
SCHEDULER_ENABLED=true
